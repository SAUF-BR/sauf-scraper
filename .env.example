# Copie para .env e ajuste. O .env NÃO vai para o Git.
SAUF_API_BASE_URL=http://localhost:8080
SAUF_API_KEY=troque-por-um-segredo
# Espera pela resposta da API, em segundos: o POST do censo no Supabase remoto leva ~3 min.
SAUF_API_TIMEOUT_SECONDS=300
SAUF_REQUEST_DELAY_SECONDS=2
# Base pública das figuras das questões (bucket do Supabase). Vazio = link original do GitHub.
# Ex.: https://<projeto>.supabase.co/storage/v1/object/public/questoes-enem
SAUF_QUESTOES_IMAGENS_URL=https://ID-DO-PROJETO.supabase.co/storage/v1/object/public/questoes-enem/imagens
